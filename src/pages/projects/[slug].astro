---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = project.data;
---

<Base title={d.title} description={d.summary}>
  <article class="container narrow page">
    <a class="back" href={`${base}/projects/`}>← All projects</a>
    <p class="eyebrow">{d.context}{d.year && ` · ${d.year}`}</p>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    {d.cover && <img class="cover" src={`${base}${d.cover}`} alt="" />}
    <div class="prose"><Content /></div>
    {d.stack.length > 0 && (
      <aside class="stack">
        <h2>Stack</h2>
        <ul class="tags">{d.stack.map((s) => <li>{s}</li>)}</ul>
      </aside>
    )}
    <nav class="next">
      <span>Next project</span>
      <a href={`${base}/projects/${next.id}/`}>{next.data.title} →</a>
    </nav>
  </article>
</Base>

<style>
  .page { padding-top: 56px; padding-bottom: 40px; }
  .back { display: inline-block; font-size: 0.9rem; margin-bottom: 32px; text-decoration: none; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 20px; }
  .cover { border-radius: var(--radius); margin: 32px 0; }
  .stack { margin-top: 40px; padding: 24px; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); }
  .stack h2 { font-size: 1.1rem; margin-bottom: 14px; }
  .next { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--rule); display: grid; gap: 4px; }
  .next span { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); }
  .next a { font-family: var(--serif); font-size: 1.3rem; text-decoration: none; }
</style>
