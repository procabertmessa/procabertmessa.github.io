---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Lightbox from '../../components/Lightbox.astro';
import ArchitectureProject from '../../components/ArchitectureProject.astro';
import Base from '../../layouts/Base.astro';
import { getProjects, getProjectPages, sheetNumber } from '../../lib/projects';
import { disciplineLabel } from '../../data/categories';

export async function getStaticPaths() {
  const all = await getProjects();
  const projects = await getProjectPages();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, all, prev: projects[(i - 1 + projects.length) % projects.length], next: projects[(i + 1) % projects.length] },
  }));
}

const { project, all, prev, next } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = project.data;
const no = sheetNumber(all, project.id);
// Projects without the data tag lead with images: see ArchitectureProject.
const isArch = !d.disciplines.includes('data');
// The cover leads the gallery; drafts without images show empty frames so the layout reads.
const gallery = [...(d.cover ? [{ src: d.cover, caption: d.title }] : []), ...d.images];
const placeholders = gallery.length === 0 && d.draft ? 3 : 0;
const mode = d.gallery;
const hasSide = (mode === 'side' || mode === 'stack') && (gallery.length > 0 || placeholders > 0);
// In hero mode the cover runs across the page, so the plates grid starts with the next image.
const plates = gallery.map((g, i) => ({ ...g, i })).slice(mode === 'hero' && d.cover ? 1 : 0);
const showPlates = mode !== 'side' && mode !== 'stack' && (plates.length > 0 || placeholders > 0);
// Legend band under the text: what the project shows Pablo can do, and the tools used.
const legends = ([['Skills', d.skills ?? []], ['Tools', d.stack ?? []]] as [string, string[]][]).filter(([, items]) => items.length > 0);
const facts = [
  ['Type', d.disciplines.map(disciplineLabel).join(' · ')],
  ['With', d.context],
  ['Role', d.role],
  ['Location', d.location],
  ['Year', d.year],
].filter(([, v]) => v) as [string, string][];
---

<Base title={d.title} description={d.summary} sheet={no} sheetTitle={d.title}>
  {isArch ? (
    <ArchitectureProject project={project} no={no} />
  ) : (
  <>
  <section class="pad head">
    <p class="mono caps muted"><a href={`${base}/projects/`}>P-00 Register</a> / <span class="accent">{no}</span></p>
    <h1>{d.title}{d.draft && <span class="draft">Draft</span>}</h1>
    <p class="lede measure">{d.summary}</p>
    {d.url && (
      <a class="visit mono caps" href={d.url} rel="noopener" target="_blank">Visit {d.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗</a>
    )}
  </section>

  {mode === 'hero' && d.cover && (
    <button type="button" class="hero" data-lightbox="0" aria-label="View images full screen">
      <Image src={d.cover} alt={d.title} widths={[800, 1400, 2200]} sizes="100vw" loading="eager" />
      <span class="hint mono caps">Fig. 01 · View full screen ⤢</span>
    </button>
  )}

  <dl class="facts">
    {facts.map(([k, v]) => (
      <div><dt>{k}</dt><dd>{v}</dd></div>
    ))}
    {d.url && (
      <div><dt>Live</dt><dd><a href={d.url} rel="noopener" target="_blank">{d.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗</a></dd></div>
    )}
  </dl>

  <section class:list={['band body', { 'has-side': hasSide }]}>
    <div class="pad prose measure"><Content /></div>
    {hasSide && (
      <aside class="side">
        {mode === 'stack' ? (
          <div class="stack">
            {gallery.map((g, i) => (
              <figure>
                <button type="button" data-lightbox={i} aria-label={`View figure ${i + 1} full screen`}>
                  <Image src={g.src} alt={g.caption ?? d.title} widths={[700, 1200]} sizes="(max-width: 860px) 100vw, 50vw" />
                </button>
                <figcaption class="mono"><span class="accent">Fig. {String(i + 1).padStart(2, '0')}</span> {g.caption}</figcaption>
              </figure>
            ))}
          </div>
        ) : (
        <div class="viewer">
          {gallery.length > 0 ? (
            <button type="button" class="main" data-lightbox="0" data-main aria-label="View full screen">
              {gallery.map((g, i) => (
                <Image src={g.src} alt={g.caption ?? d.title} widths={[700, 1200]} sizes="(max-width: 860px) 100vw, 50vw" class:list={[{ on: i === 0 }]} data-fig={i} />
              ))}
            </button>
          ) : (
            <div class="main empty"><span class="mono caps">Images to come</span></div>
          )}
          <p class="cap mono"><span class="accent" data-fig-no>Fig. 01</span> <span data-fig-cap>{gallery[0]?.caption}</span></p>
          {gallery.length > 1 && (
            <div class="thumbs">
              {gallery.map((g, i) => (
                <button type="button" class:list={['thumb', { on: i === 0 }]} data-thumb={i} data-caption={g.caption ?? ''} aria-label={`Figure ${i + 1}`}>
                  <Image src={g.src} alt="" widths={[200]} sizes="120px" />
                </button>
              ))}
            </div>
          )}
        </div>
        )}
      </aside>
    )}
  </section>

  {showPlates && (
    <section class="band plates-band">
      <div class="band-head"><span>Plates</span><span>{gallery.length || 'Pending'}</span></div>
      <div class:list={['plates', `plates-${mode}`]}>
        {plates.map((g) => (
          <figure>
            <button type="button" data-lightbox={g.i} aria-label={`View figure ${g.i + 1} full screen`}>
              <Image src={g.src} alt={g.caption ?? d.title} widths={[700, 1200]} sizes="(max-width: 860px) 100vw, 50vw" />
            </button>
            <figcaption class="mono"><span class="accent">Fig. {String(g.i + 1).padStart(2, '0')}</span> {g.caption}</figcaption>
          </figure>
        ))}
        {plates.length === 0 && Array.from({ length: placeholders }, (_, i) => (
          <figure><div class="empty"><span class="mono caps">Fig. {String(i + 1).padStart(2, '0')}</span></div></figure>
        ))}
      </div>
    </section>
  )}

  {gallery.length > 0 && <Lightbox title={d.title} images={gallery} />}

  {legends.length > 0 && (
    <section class="band legends">
      {legends.map(([label, items]) => (
        <div>
          <div class="band-head"><span>{label}</span></div>
          <ul class="tools mono">{items.map((s) => <li>{s}</li>)}</ul>
        </div>
      ))}
    </section>
  )}

  </>
  )}

  <nav class="band pager" aria-label="More projects">
    <a href={`${base}/projects/${prev.id}/`}><span class="mono muted">← {sheetNumber(all, prev.id)}</span>{prev.data.title}</a>
    <a class="right" href={`${base}/projects/${next.id}/`}><span class="mono muted">{sheetNumber(all, next.id)} →</span>{next.data.title}</a>
  </nav>
</Base>

<script>
  // Side viewer: a thumbnail swaps the large image; the large image opens the full-screen viewer there.
  const main = document.querySelector<HTMLElement>('[data-main]');
  document.querySelectorAll<HTMLElement>('[data-thumb]').forEach((t) =>
    t.addEventListener('click', () => {
      const i = t.dataset.thumb!;
      main!.dataset.lightbox = i;
      main!.querySelectorAll<HTMLElement>('[data-fig]').forEach((im) => im.classList.toggle('on', im.dataset.fig === i));
      document.querySelectorAll<HTMLElement>('[data-thumb]').forEach((o) => o.classList.toggle('on', o === t));
      document.querySelector('[data-fig-no]')!.textContent = `Fig. ${String(Number(i) + 1).padStart(2, '0')}`;
      document.querySelector('[data-fig-cap]')!.textContent = t.dataset.caption ?? '';
    }),
  );
</script>

<style>
  .head h1 { font-size: clamp(40px, 5.6vw, 80px); letter-spacing: -0.045em; margin: 14px 0 24px; }
  .head .lede { font-size: 20px; line-height: 1.5; color: var(--body); margin: 0; }
  .head a { text-decoration: none; }
  .visit { display: inline-block; margin-top: 28px; padding: 10px 16px; border: 1px solid var(--ink); border-radius: 999px; color: var(--ink); font-size: 11px; }
  .visit:hover { background: var(--ink); color: var(--paper); }

  .facts { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .facts div { padding: 16px 18px; }
  .facts div:first-child { border-left: 0; }
  .facts dt { font-family: var(--mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .facts dd { margin: 2px 0 0; color: var(--ink); font-size: 14px; }

  .body { display: grid; grid-template-columns: 1fr 280px; }
  .body.has-side { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } /* divider lines up with the facts and pager */
  .side { display: flex; flex-direction: column; }
  .viewer { position: sticky; top: 0; padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .viewer .main { position: relative; display: grid; padding: 0; border: 0; background: none; cursor: zoom-in; align-items: start; }
  .viewer .main :global(img) { grid-area: 1 / 1; width: 100%; height: auto; opacity: 0; transition: opacity 0.25s; }
  .viewer .main :global(img.on) { opacity: 1; }
  .viewer .cap { margin: 0; font-size: 12px; color: var(--body); }
  .thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; }
  .thumb { padding: 0; border: 0; background: none; aspect-ratio: 4 / 3; cursor: pointer; opacity: 0.4; }
  .thumb.on, .thumb:hover { opacity: 1; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  .stack { display: flex; flex-direction: column; gap: 40px; padding: 24px; }
  .stack figure { margin: 0; }
  .stack button { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .stack button :global(img) { display: block; width: 100%; height: auto; }
  .stack button:hover { outline: 1px solid var(--accent); }
  .stack figcaption { margin-top: 10px; font-size: 12px; color: var(--body); }

  .hero { display: block; position: relative; width: 100%; padding: 0; border: 0; border-top: 1px solid var(--line); background: none; cursor: zoom-in; }
  .hero :global(img) { display: block; width: 100%; height: min(72vh, 760px); object-fit: cover; }
  .hint { position: absolute; left: 18px; bottom: 14px; padding: 6px 10px; background: rgba(5, 5, 5, 0.75); color: #ece8df; font-size: 11px; }

  .plates { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .plates figure { margin: 0; padding: 24px; border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .plates figure:nth-child(2n + 1) { border-left: 0; }
  .plates button { display: block; width: 100%; padding: 0; border: 1px solid var(--line); background: none; cursor: zoom-in; }
  .plates button :global(img) { display: block; width: 100%; height: auto; }
  .plates-hero figure:last-child:nth-child(odd) { grid-column: 1 / -1; border-left: 0; }
  .plates button:hover { outline: 1px solid var(--accent); }
  .plates figcaption { margin-top: 10px; font-size: 12px; color: var(--body); }
  .plates-sheet figure:first-child { grid-column: 1 / -1; }
  .plates-sheet figure:nth-child(2n + 1) { border-left: 1px solid var(--line); }
  .plates-sheet figure:nth-child(2n) { border-left: 0; }
  .empty { display: grid; place-items: center; aspect-ratio: 4 / 3; border: 1px dashed var(--muted); color: var(--muted); }
  .legends { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  
  .tools { list-style: none; margin: 0; padding: 4px 18px 18px; display: flex; flex-wrap: wrap; gap: 8px; color: var(--ink); }
  .tools li { padding: 5px 10px; border: 1px solid var(--line); border-radius: 999px; }
  

  .pager { display: grid; grid-template-columns: 1fr 1fr; margin-top: 48px; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 18px; text-decoration: none; color: var(--ink); font-size: 18px; letter-spacing: -0.01em; }
  .pager a:hover { background: var(--hover-bg); color: var(--hover-fg); }
  .pager a:hover span { color: var(--hover-fg); }
  .pager .right { text-align: right; }

  @media (max-width: 860px) {
    .body, .body.has-side { grid-template-columns: 1fr; }
    .side { border-left: 0; border-top: 1px solid var(--line); order: -1; }
    .viewer { position: static; }
    .plates { grid-template-columns: 1fr; }
    .plates figure, .plates-sheet figure:nth-child(n) { border-left: 0; }
    .hero :global(img) { height: 46vh; }
    .facts div { border-top: 0.5px solid var(--faint); }
  }
  @media (max-width: 520px) {
    .pager { grid-template-columns: 1fr; }
    .pager .right { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
