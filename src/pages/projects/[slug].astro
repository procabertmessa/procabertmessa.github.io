---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { getProjects } from '../../lib/projects';
import Base from '../../layouts/Base.astro';
import { categoryLabel } from '../../data/categories';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = project.data;
const facts = [
  ['Type', categoryLabel(d.category)],
  ['With', d.context],
  ['Role', d.role],
  ['Where', d.location],
  ['When', d.year],
  ['Tools', d.stack.join(', ')],
].filter(([, v]) => v) as [string, string][];
---

<Base title={d.title} description={d.summary}>
  <article class="container narrow page">
    <a class="back" href={`${base}/projects/`}>← Projects</a>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <dl class="facts">
      {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    </dl>
    {d.draft && <p class="draft-note">Draft: hidden on the live site until <code>draft: false</code>.</p>}
    {d.cover && <figure class="wide cover"><Image src={d.cover} alt={d.title} widths={[800, 1400, 2000]} sizes="(max-width: 1000px) 100vw, 960px" loading="eager" /></figure>}
    <div class="prose"><Content /></div>
    {d.images.length > 0 && (
      <div class="wide gallery">
        {d.images.map((img) => (
          <figure>
            <Image src={img.src} alt={img.caption ?? d.title} widths={[800, 1400, 2000]} sizes="(max-width: 1000px) 100vw, 960px" />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}
    <p class="next"><span class="muted">Next</span> <a href={`${base}/projects/${next.id}/`}>{next.data.title}</a></p>
  </article>
</Base>

<style>
  .page { padding-top: 48px; }
  .back { display: inline-block; font-size: 0.9rem; margin-bottom: 40px; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--ink); }
  h1 { margin-bottom: 20px; }
  .facts { display: grid; grid-template-columns: 80px 1fr; gap: 6px 20px; margin: 32px 0; padding: 20px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); font-size: 0.9rem; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; color: var(--ink); }
  /* Images break out of the text column to the full page width. */
  .wide { width: min(912px, calc(100vw - 48px)); margin-left: 50%; transform: translateX(-50%); }
  .wide :global(img) { width: 100%; height: auto; }
  .cover { margin-top: 32px; margin-bottom: 40px; }
  .draft-note { font-size: 0.85rem; color: var(--muted); border: 1px dashed var(--rule); padding: 10px 14px; }
  .gallery { display: grid; gap: 48px; margin-top: 56px; }
  .gallery figure { margin: 0; }
  figcaption { font-size: 0.85rem; color: var(--muted); margin-top: 8px; }
  .next { margin-top: 64px; padding-top: 20px; border-top: 1px solid var(--rule); font-size: 0.95rem; }
</style>
