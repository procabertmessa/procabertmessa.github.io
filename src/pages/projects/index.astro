---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Selected urban analytics, digital twin and climate-resilience projects.">
  <section class="container head">
    <p class="eyebrow">Selected work</p>
    <h1>Projects</h1>
    <p class="lede">Parcel-level datasets, digital twins, climate resilience and innovation diagnostics, from Catalonia to the Western Cape and Boston.</p>
  </section>
  <section class="container grid">
    {projects.map((p, i) => <ProjectCard slug={p.id} index={i} {...p.data} />)}
  </section>
</Base>

<style>
  .head { padding-top: 80px; padding-bottom: 48px; max-width: var(--narrow); margin-left: max(0px, calc((100% - var(--max)) / 2)); }
  .head .lede { margin-top: 20px; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; padding-bottom: 40px; }
  @media (max-width: 760px) {
    .head { padding-top: 48px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
