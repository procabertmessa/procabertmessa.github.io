---
import { getProjects } from '../../lib/projects';
import Base from '../../layouts/Base.astro';
import { categories } from '../../data/categories';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getProjects();
// Only show categories that have at least one project.
const groups = categories
  .map((c) => ({ ...c, items: all.filter((p) => p.data.category === c.id) }))
  .filter((g) => g.items.length > 0);
---

<Base title="Projects" description="Urban analytics, urban design and architecture projects.">
  <section class="container narrow head">
    <h1>Projects</h1>
  </section>
  {groups.map((g) => (
    <section class="container narrow group">
      <p class="label">{g.label}</p>
      <ul class="rows">
        {g.items.map((p) => (
          <li>
            <a class="row" href={`${base}/projects/${p.id}/`}>
              <span class="t">{p.data.title}{p.data.draft && <span class="draft">Draft</span>}</span>
              <span class="m">{[p.data.location, p.data.year].filter(Boolean).join(', ')}</span>
              <span class="s">{p.data.context}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .head { padding-top: 72px; padding-bottom: 24px; }
  .group { padding-top: 32px; padding-bottom: 16px; }
  @media (max-width: 640px) { .head { padding-top: 40px; } }
</style>
