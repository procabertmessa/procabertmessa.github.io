---
import { Image } from 'astro:assets';
import Mockup from '../../layouts/Mockup.astro';
import QA from '../../components/mockup/QA.astro';
import portrait from '../../assets/pablo-portrait.jpg';
import { person, skills, experience, education, languages, stats } from '../../data/cv';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Mockup title="About" active="about" root="mockup-2">
  <div class="split2">
    <aside class="stage">
      <div class="stage-box">
        <div class="stage-img on portrait" data-caption={person.location}>
          <Image src={portrait} alt={person.name} widths={[600, 1100]} sizes="(max-width: 900px) 100vw, 55vw" loading="eager" />
        </div>
      </div>
      <div class="stage-meta"><span class="stage-cap mono muted">{person.location}</span><span class="mono muted">{person.headline}</span></div>
    </aside>

    <div class="panel">
      <p class="crumb mono muted">About</p>
      <h1>Architect by training, urban designer by practice.</h1>
      <p class="lede">{person.profile[0]}</p>

      <div class="card mono">
        <div class="card-head muted"><span>Profile card</span><span>pablo-rocabert</span></div>
        <dl>
          {stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
          <div><dt>status</dt><dd>{person.status}</dd></div>
          <div><dt>cv</dt><dd><a href={`${base}${person.cv.en}`}>English ↓</a> · <a href={`${base}${person.cv.es}`}>Español ↓</a></dd></div>
        </dl>
      </div>

      <div class="qa" data-qa>
        <p class="qa-label mono muted"><span class="spark">✦</span> Ask about Pablo</p>
        <div class="qa-chips"></div>
        <div class="qa-out">
          <section class="qa-sec" data-q="How does he work?">
            {person.profile.slice(1).map((p) => <p>{p}</p>)}
          </section>
          <section class="qa-sec" data-q="Where has he worked?">
            <ul class="rows">
              {experience.map((j) => <li><span class="t">{j.roles[0].title}</span><span class="muted">{j.org}</span><span class="mono muted">{j.roles[j.roles.length - 1].dates.split('–')[0].trim()} – {j.roles[0].dates.split('–')[1].trim()}</span></li>)}
            </ul>
          </section>
          <section class="qa-sec" data-q="What did he study?">
            <ul class="rows">
              {education.map((e) => <li><span class="t">{e.title}</span><span class="muted">{e.school}</span></li>)}
            </ul>
          </section>
          <section class="qa-sec" data-q="What are his skills?">
            {skills.map((s) => <p><strong>{s.group}.</strong> {s.items.map((it) => it.replace(/ \(.*\)/, '')).join(', ')}.</p>)}
          </section>
          <section class="qa-sec" data-q="Which languages?">
            <ul class="rows">{languages.map((l) => <li><span class="t">{l.name}</span><span class="muted">{l.level}</span></li>)}</ul>
          </section>
        </div>
      </div>
    </div>
  </div>
  <QA />
</Mockup>

<style>
  .portrait :global(img) { filter: grayscale(1) contrast(1.05); object-position: 50% 30%; }
  .rows { list-style: none; padding: 0 !important; margin: 0; }
  .rows li { display: flex; flex-direction: column; gap: 1px; padding: 10px 0; border-bottom: 1px dashed var(--line); }
  .rows li:first-child { padding-top: 0; }
  .rows li:last-child { border-bottom: 0; }
  .t { color: var(--ink); }
  .rows .mono { font-size: 11px; }
</style>
