---
import Base from '../layouts/Base.astro';
import { person, skills, experience, education, languages } from '../data/cv';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="About" description={person.profile[0]}>
  <section class="container narrow head">
    <h1>About</h1>
    <div class="prose">
      {person.profile.map((p, i) => <p class={i === 0 ? 'lede' : ''}>{p}</p>)}
      <p class="muted small">{person.status}</p>
      <p class="small">Download CV: <a href={`${base}${person.cv.en}`}>English</a> · <a href={`${base}${person.cv.es}`}>Español</a></p>
    </div>
  </section>

  <section class="container narrow section">
    <p class="label">Experience</p>
    {experience.map((j) => (
      <article class="job">
        <h2>{j.org} <span class="muted">· {j.location}</span></h2>
        {j.roles.map((r) => (
          <p class="role"><span>{r.title}</span><span class="muted">{r.dates}</span></p>
        ))}
        <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
      </article>
    ))}
  </section>

  <section class="container narrow section">
    <p class="label">Skills</p>
    <dl class="skills">
      {skills.map((s) => (
        <>
          <dt>{s.group}</dt>
          <dd>{s.items.join(', ')}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="container narrow section">
    <p class="label">Education</p>
    <ul class="rows">
      {education.map((e) => (
        <li>
          <div class="row">
            <span class="t">{e.title}</span>
            <span class="m">{e.dates}</span>
            <span class="s">{e.school}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container narrow section">
    <p class="label">Languages</p>
    <p>{languages.map((l) => `${l.name} (${l.level.toLowerCase()})`).join(', ')}</p>
  </section>
</Base>

<style>
  .head { padding-top: 72px; padding-bottom: 32px; }
  .head h1 { margin-bottom: 32px; }
  .small { font-size: 0.9rem; }
  .job { margin-bottom: 40px; }
  .job:last-child { margin-bottom: 0; }
  .job h2 { margin-bottom: 10px; }
  .role { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 0 0 2px; font-size: 0.95rem; }
  .job ul { padding-left: 1.1em; margin: 12px 0 0; font-size: 0.95rem; }
  .job li { margin-bottom: 6px; }
  .skills { display: grid; grid-template-columns: 160px 1fr; gap: 14px 24px; margin: 0; font-size: 0.95rem; }
  .skills dt { color: var(--ink); }
  .skills dd { margin: 0; }
  @media (max-width: 640px) {
    .head { padding-top: 40px; }
    .skills { grid-template-columns: 1fr; gap: 4px; }
    .skills dd { margin-bottom: 12px; }
  }
</style>
