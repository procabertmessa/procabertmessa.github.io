---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/pablo-portrait.jpg';
import { person, skills, experience, education, languages } from '../data/cv';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="About" description={person.profile[0]} sheet="A-01" sheetTitle="Profile">
  <section class="pad head">
    <div>
      <p class="mono caps muted">Sheet A-01 · Profile</p>
      <h1>Architect by training, data scientist by practice.</h1>
    </div>
    <!-- The portrait sits inside an Eixample block: 113 m square with 15 m chamfers, ringed by half a 20 m street. -->
    <figure class="portrait">
      <svg viewBox="0 0 133.3 133.3" aria-hidden="true">
        <path d="M20.9 0 H112.4 L133.3 20.9 V112.4 L112.4 133.3 H20.9 L0 112.4 V20.9 Z" />
      </svg>
      <Image src={portrait} alt={person.name} widths={[360, 720]} sizes="(max-width: 860px) 70vw, 340px" loading="eager" />
      <figcaption class="mono muted">{person.name} · {person.location}</figcaption>
    </figure>
  </section>

  <section class="band split">
    <div class="pad prose measure">
      {person.profile.map((p, i) => <p class={i === 0 ? 'first' : ''}>{p}</p>)}
    </div>
    <aside class="side">
      <div class="band-head"><span>Status</span></div>
      <p class="pad-s">{person.status}</p>
      <div class="band-head top"><span>Downloads</span></div>
      <ul class="dl mono">
        <li><a href={`${base}${person.cv.en}`}>↓ CV, English (PDF)</a></li>
        <li><a href={`${base}${person.cv.es}`}>↓ CV, Español (PDF)</a></li>
      </ul>
    </aside>
  </section>

  <section class="band">
    <div class="band-head"><span>Revision history · Experience</span><span>{experience.length}</span></div>
    {experience.map((j, i) => (
      <article class="job">
        <div class="job-side">
          <span class="mono accent">Rev. {String.fromCharCode(68 - i)}</span>
          <h2>{j.org}</h2>
          <span class="mono muted">{j.location}</span>
        </div>
        <div>
          {j.about && <p class="about">{j.about}</p>}
          {j.roles.map((r) => (
            <p class="role"><span>{r.title}</span><span class="mono muted">{r.dates}</span></p>
          ))}
          <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      </article>
    ))}
  </section>

  <section class="band">
    <div class="band-head"><span>Legend · Skills</span></div>
    <dl class="skills">
      {skills.map((s) => (
        <div>
          <dt class="mono caps">{s.group}</dt>
          <dd>{s.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="band two">
    <div>
      <div class="band-head"><span>Education</span></div>
      <ol class="register">
        {education.map((e) => (
          <li>
            <div class="reg-row">
              <span class="no">{e.dates.split('–')[1]?.trim() ?? e.dates}</span>
              <span class="title">{e.title}</span>
              <span class="meta"></span>
              <span class="sub">{e.school}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="langs">
      <div class="band-head"><span>Languages</span></div>
      <ol class="register">
        {languages.map((l) => (
          <li>
            <div class="reg-row"><span class="no">{l.code}</span><span class="title">{l.name}</span><span class="meta">{l.level}</span></div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .head { display: grid; grid-template-columns: 1fr minmax(220px, 340px); gap: 48px; align-items: end; }
  .head h1 { font-size: clamp(40px, 6vw, 84px); letter-spacing: -0.04em; margin-top: 10px; max-width: 14ch; }
  .portrait { position: relative; margin: 0; aspect-ratio: 1; }
  .portrait svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .portrait path { fill: none; stroke: var(--muted); stroke-width: 1.4; stroke-dasharray: 0 5; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .portrait :global(img) {
    position: absolute; inset: 7.5%; width: 85%; height: 85%; object-fit: cover;
    clip-path: polygon(13.2% 0, 86.8% 0, 100% 13.2%, 100% 86.8%, 86.8% 100%, 13.2% 100%, 0 86.8%, 0 13.2%);
  }
  .portrait figcaption { position: absolute; left: 0; right: 0; bottom: -26px; text-align: center; font-size: 10.5px; }
  .split { display: grid; grid-template-columns: 1fr 340px; }
  .prose .first { font-size: 21px; line-height: 1.45; color: var(--ink); }
  .side { border-left: 1px solid var(--line); }
  .pad-s { padding: 14px 18px; margin: 0; font-size: 14px; }
  .top { border-top: 1px solid var(--line); }
  .dl { list-style: none; margin: 0; padding: 14px 18px; display: grid; gap: 8px; font-size: 12px; }

  .job { display: grid; grid-template-columns: 300px 1fr; gap: 32px; padding: 26px 18px; border-bottom: 0.5px solid var(--faint); }
  .job:last-child { border-bottom: 0; }
  .job-side { display: flex; flex-direction: column; gap: 6px; }
  .job h2 { font-size: 22px; letter-spacing: -0.02em; line-height: 1.15; }
  .about { font-size: 14px; color: var(--muted); }
  .role { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 0 0 2px; color: var(--ink); }
  .job ul { padding-left: 1.1em; margin: 12px 0 0; font-size: 15px; }
  .job li { margin-bottom: 6px; }
  .job li::marker { color: var(--accent); }

  .skills { margin: 0; display: grid; grid-template-columns: 1fr 1fr; }
  .skills div { padding: 18px; border-bottom: 0.5px solid var(--faint); }
  .skills div:nth-child(odd) { border-right: 1px solid var(--line); }
  .skills dt { color: var(--accent); margin-bottom: 6px; }
  .skills dd { margin: 0; font-size: 15px; color: var(--ink); }

  .two { display: grid; grid-template-columns: 1.4fr 1fr; }
  .langs { border-left: 1px solid var(--line); }

  @media (max-width: 860px) {
    .split, .two, .job, .skills, .head { grid-template-columns: 1fr; }
    .portrait { width: min(320px, 78vw); margin-bottom: 30px; }
    .side, .langs { border-left: 0; border-top: 1px solid var(--line); }
    .skills div:nth-child(odd) { border-right: 0; }
    .job { gap: 14px; padding: 22px 14px; }
  }
</style>
