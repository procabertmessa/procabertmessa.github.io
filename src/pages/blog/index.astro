---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Blog" description="Notes on urban data, digital twins, planning and design.">
  <section class="container narrow head">
    <p class="eyebrow">Writing</p>
    <h1>Blog</h1>
    <p class="lede">Notes on urban data, digital twins, planning and design.</p>
  </section>
  <section class="container narrow list">
    {posts.length === 0 ? (
      <p class="empty">The first posts are on their way. In the meantime, have a look at the <a href={`${base}/projects/`}>projects</a>.</p>
    ) : (
      <ul>
        {posts.map((p) => (
          <li>
            <a href={`${base}/blog/${p.id}/`}>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .head { padding-top: 80px; padding-bottom: 32px; }
  .head .lede { margin-top: 20px; }
  .list { padding-bottom: 40px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li a { display: block; padding: 28px 0; border-top: 1px solid var(--rule); text-decoration: none; color: inherit; }
  time { font-size: 0.85rem; color: var(--muted); }
  h2 { font-size: 1.6rem; margin: 6px 0 8px; }
  li a:hover h2 { color: var(--accent); }
  li p { margin: 0; color: var(--muted); }
  .empty { padding: 32px; border: 1px dashed var(--rule); border-radius: var(--radius); color: var(--muted); }
  @media (max-width: 640px) { .head { padding-top: 48px; } }
</style>
