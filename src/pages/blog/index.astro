---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Blog" description="Notes on urban data, digital twins, planning and design.">
  <section class="container narrow head">
    <h1>Blog</h1>
  </section>
  <section class="container narrow">
    {posts.length === 0 ? (
      <p class="muted">No posts yet.</p>
    ) : (
      <ul class="rows">
        {posts.map((p) => (
          <li>
            <a class="row" href={`${base}/blog/${p.id}/`}>
              <span class="t">{p.data.title}</span>
              <span class="m">{fmt(p.data.date)}</span>
              <span class="s">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .head { padding-top: 72px; padding-bottom: 32px; }
  @media (max-width: 640px) { .head { padding-top: 40px; } }
</style>
