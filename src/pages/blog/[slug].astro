---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={post.data.title} description={post.data.description}>
  <article class="container narrow page">
    <a class="back" href={`${base}/blog/`}>← All posts</a>
    <time datetime={post.data.date.toISOString()}>{date}</time>
    <h1>{post.data.title}</h1>
    <p class="lede">{post.data.description}</p>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .page { padding-top: 56px; padding-bottom: 40px; }
  .back { display: inline-block; font-size: 0.9rem; margin-bottom: 40px; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--ink); }
  time { display: block; font-size: 0.9rem; color: var(--muted); margin-bottom: 12px; }
  h1 { margin-bottom: 20px; }
  .lede { margin-bottom: 36px; }
</style>
