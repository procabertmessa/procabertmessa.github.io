---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, no: `B-${String(i + 1).padStart(2, '0')}` } }));
}

const { post, no } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={post.data.title} description={post.data.description} sheet={no} sheetTitle={post.data.title}>
  <section class="pad head">
    <p class="mono caps muted"><a href={`${base}/blog/`}>B-00 Notes</a> / <span class="red">{no}</span> · <time datetime={post.data.date.toISOString()}>{date}</time></p>
    <h1>{post.data.title}</h1>
    <p class="lede measure">{post.data.description}</p>
  </section>
  <article class="band">
    <div class="pad prose measure"><Content /></div>
  </article>
</Base>

<style>
  .head h1 { font-size: clamp(36px, 5.5vw, 72px); letter-spacing: -0.04em; margin: 10px 0 20px; max-width: 18ch; }
  .head a { text-decoration: none; }
  .lede { font-size: 20px; line-height: 1.45; color: var(--ink); margin: 0; }
</style>
