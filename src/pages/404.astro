---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page not found">
  <section class="container narrow" style="padding: 120px 20px;">
    <p class="label">404</p>
    <h1>Page not found.</h1>
    <p class="lede" style="margin-top: 20px;"><a href={`${base}/`}>Back to the home page</a>.</p>
  </section>
</Base>
