---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Sheet not found" sheet="404" sheetTitle="Missing sheet">
  <section class="pad" style="padding-top: 96px; padding-bottom: 96px;">
    <p class="mono caps muted">Sheet 404</p>
    <h1 style="font-size: clamp(44px, 7vw, 96px); letter-spacing: -0.045em; margin: 10px 0 24px;">This sheet is missing from the set.</h1>
    <p><a href={`${base}/`}>← Back to the cover sheet</a></p>
  </section>
</Base>
