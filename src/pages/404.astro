---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page not found">
  <section class="container narrow" style="padding: 120px 20px;">
    <p class="eyebrow">404</p>
    <h1>This parcel is empty.</h1>
    <p class="lede" style="margin-top: 20px;">The page you were looking for doesn't exist. <a href={`${base}/`}>Back to the home page</a>.</p>
  </section>
</Base>
