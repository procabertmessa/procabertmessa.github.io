---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { person, experience } from '../data/cv';
import { categoryLabel } from '../data/categories';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<Base>
  <section class="container narrow intro">
    <h1>{person.shortName}</h1>
    <p class="role">{person.headline}, Barcelona</p>
    <p class="lede">{person.intro}</p>
    <p class="links">
      <a href={`mailto:${person.email}`}>Email</a>
      <a href={person.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <a href={`${base}${person.cv.en}`}>CV (EN)</a>
      <a href={`${base}${person.cv.es}`}>CV (ES)</a>
    </p>
  </section>

  <section class="container narrow section">
    <p class="label">Selected work</p>
    <ul class="rows">
      {projects.map((p) => (
        <li>
          <a class="row" href={`${base}/projects/${p.id}/`}>
            <span class="t">{p.data.title}</span>
            <span class="m">{categoryLabel(p.data.category)}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="more"><a href={`${base}/projects/`}>All projects</a></p>
  </section>

  <section class="container narrow section">
    <p class="label">Experience</p>
    <ul class="rows">
      {experience.map((j) => (
        <li>
          <div class="row">
            <span class="t">{j.roles[0].title}, <span class="muted">{j.org}</span></span>
            <span class="m">{j.roles[j.roles.length - 1].dates.split('–')[0].trim()} – {j.roles[0].dates.split('–')[1].trim()}</span>
          </div>
        </li>
      ))}
    </ul>
    <p class="more"><a href={`${base}/about/`}>More about me</a></p>
  </section>

  {posts.length > 0 && (
    <section class="container narrow section">
      <p class="label">Writing</p>
      <ul class="rows">
        {posts.map((p) => (
          <li>
            <a class="row" href={`${base}/blog/${p.id}/`}>
              <span class="t">{p.data.title}</span>
              <span class="m">{fmt(p.data.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .intro { padding-top: 72px; padding-bottom: 56px; }
  .role { color: var(--muted); margin: 8px 0 32px; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 32px; font-size: 0.95rem; }
  .more { margin-top: 20px; font-size: 0.9rem; }
  @media (max-width: 640px) { .intro { padding-top: 40px; } }
</style>
