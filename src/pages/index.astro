---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { person, stats, experience } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// A small abstract "parcel map" for the hero, drawn from a fixed seed so it never changes between builds.
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const cells: { x: number; y: number; w: number; h: number; tone: number }[] = [];
for (let row = 0; row < 6; row++) {
  let x = 0;
  while (x < 300) {
    const w = 30 + Math.floor(rand() * 60);
    cells.push({ x, y: row * 50, w: Math.min(w, 300 - x), h: 50, tone: rand() });
    x += w;
  }
}
---

<Base>
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow">{person.headline}</p>
      <h1>Designing cities with <em>evidence</em>.</h1>
      <p class="lede">{person.intro}</p>
      <div class="actions">
        <a class="btn btn-primary" href={`${base}/projects/`}>See my projects</a>
        <a class="btn btn-ghost" href={`${base}${person.cv.en}`}>Download CV</a>
      </div>
      <p class="where">{person.location} · Senior Urban Designer & Data Scientist at Aretian</p>
    </div>
    <figure class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 300 300" role="presentation">
        {cells.map((c) => (
          <rect
            x={c.x + 3} y={c.y + 3} width={c.w - 6} height={c.h - 6} rx="3"
            class={c.tone > 0.82 ? 'hot' : c.tone > 0.55 ? 'mid' : 'low'}
          />
        ))}
        <path d="M0 152 C 80 120, 140 190, 300 140" class="river" />
      </svg>
      <figcaption>Every parcel tells a story.</figcaption>
    </figure>
  </section>

  <section class="container stats">
    {stats.map((s) => (
      <div class="stat">
        <span class="val">{s.value}</span>
        <span class="lab">{s.label}</span>
      </div>
    ))}
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Projects</h2>
        </div>
        <a href={`${base}/projects/`}>All projects →</a>
      </div>
      <div class="grid">
        {projects.map((p, i) => (
          <ProjectCard slug={p.id} index={i} {...p.data} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Career</p>
        <h2>From architecture to urban data</h2>
        <p class="side-note">Eight years moving from buildings to whole territories: design, real estate investment, and now city digital twins.</p>
        <a href={`${base}/about/`}>Full experience →</a>
      </div>
      <ol class="timeline">
        {experience.map((j) => (
          <li>
            <span class="dates">{j.roles[j.roles.length - 1].dates.split('–')[0].trim()} – {j.roles[0].dates.split('–')[1].trim()}</span>
            <strong>{j.roles[0].title}</strong>
            <span class="org">{j.org}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Writing</p>
            <h2>Latest from the blog</h2>
          </div>
          <a href={`${base}/blog/`}>All posts →</a>
        </div>
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <a href={`${base}/blog/${p.id}/`}>
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <span class="pt">{p.data.title}</span>
                <span class="pd">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: 56px; align-items: center; padding-top: 80px; padding-bottom: 64px; }
  h1 em { font-style: italic; color: var(--accent); }
  .hero-text .lede { margin: 24px 0 32px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .where { margin-top: 28px; font-size: 0.9rem; color: var(--muted); }
  .hero-art { margin: 0; }
  .hero-art svg { width: 100%; height: auto; border-radius: 18px; background: var(--surface); border: 1px solid var(--rule); padding: 10px; }
  .hero-art rect.low { fill: var(--accent-soft); }
  .hero-art rect.mid { fill: color-mix(in srgb, var(--accent) 45%, var(--surface)); }
  .hero-art rect.hot { fill: var(--warm); opacity: 0.85; }
  .river { fill: none; stroke: var(--accent); stroke-width: 7; stroke-linecap: round; opacity: 0.9; }
  figcaption { font-family: var(--serif); font-style: italic; font-size: 0.95rem; color: var(--muted); margin-top: 10px; text-align: right; }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding-bottom: 72px; }
  .stat { border-top: 2px solid var(--ink); padding-top: 14px; }
  .val { display: block; font-family: var(--serif); font-size: 2.8rem; color: var(--ink); line-height: 1; margin-bottom: 8px; }
  .lab { font-size: 0.92rem; color: var(--muted); }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  .two-col { display: grid; grid-template-columns: 1fr 1.4fr; gap: 56px; }
  .side-note { margin: 18px 0; }
  .timeline { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--rule); }
  .timeline li { position: relative; padding: 0 0 28px 28px; display: grid; gap: 2px; }
  .timeline li::before { content: ''; position: absolute; left: -6px; top: 7px; width: 11px; height: 11px; border-radius: 50%; background: var(--paper); border: 2px solid var(--accent); }
  .timeline li:first-child::before { background: var(--accent); }
  .dates { font-size: 0.8rem; color: var(--muted); letter-spacing: 0.02em; }
  .timeline strong { font-family: var(--serif); font-weight: 500; font-size: 1.2rem; color: var(--ink); }
  .org { font-size: 0.95rem; }

  .posts { list-style: none; padding: 0; margin: 0; }
  .posts a { display: grid; grid-template-columns: 180px 1fr; column-gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--rule); text-decoration: none; color: inherit; }
  .posts time { color: var(--muted); font-size: 0.9rem; grid-row: span 2; }
  .pt { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); }
  .posts a:hover .pt { color: var(--accent); }
  .pd { font-size: 0.95rem; color: var(--muted); }

  @media (max-width: 900px) {
    .hero, .two-col { grid-template-columns: 1fr; gap: 40px; }
    .hero { padding-top: 48px; }
    .hero-art { max-width: 420px; }
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .stats { grid-template-columns: 1fr; gap: 16px; }
    .posts a { grid-template-columns: 1fr; }
    .posts time { grid-row: auto; }
  }
</style>
