---
import Base from '../layouts/Base.astro';
import ParcelMap from '../components/ParcelMap.astro';
import { getProjects, getFeaturedProjects, sheetNumber } from '../lib/projects';
import { person, experience } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getProjects();
const featured = await getFeaturedProjects();
const short = { 'urban-analytics': 'Data', 'urban-design': 'Urban', architecture: 'Arch' } as const;
const span = (j: (typeof experience)[number]) =>
  `${j.roles[j.roles.length - 1].dates.split('–')[0].trim()} – ${j.roles[0].dates.split('–')[1].trim()}`;
---

<Base sheet="00" sheetTitle="Cover sheet">
  <section class="hero">
    <ParcelMap />
    <div class="intro">
      <h1>Designing cities<br />with evidence.</h1>
      <p class="lede">{person.intro}</p>
    </div>
  </section>

  <section class="band">
    <div class="band-head"><span>Selected work</span><a href={`${base}/projects/`}>All projects →</a></div>
    <ol class="register">
      {featured.map((p) => (
        <li>
          <a class="reg-row" href={`${base}/projects/${p.id}/`}>
            <span class="no">{sheetNumber(all, p.id)}</span>
            <span class="title">{p.data.title}{p.data.draft && <span class="draft">Draft</span>}</span>
            <span class="meta">{short[p.data.category]}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="band">
    <div class="band-head"><span>Experience</span><a href={`${base}/about/`}>Full profile →</a></div>
    <ol class="register">
      {experience.map((j) => (
        <li>
          <div class="reg-row">
            <span class="no">{j.org}</span>
            <span class="title">{j.roles[0].title}</span>
            <span class="meta">{span(j)}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: min(72vh, 680px); display: flex; align-items: flex-end; overflow: hidden; margin-bottom: 40px; }
  .hero :global(.parcel-map) { mask-image: radial-gradient(ellipse at 70% 40%, #000 30%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 30%, transparent 75%); }
  .intro { position: relative; padding: 0 18px 24px; pointer-events: none; }
  h1 { font-size: clamp(48px, 7.4vw, 112px); line-height: 0.95; letter-spacing: -0.05em; }
  .lede { font-size: 18px; line-height: 1.55; max-width: 700px; text-wrap: balance; margin: 28px 0 0; color: var(--body); }
  .band-head a { text-decoration: none; color: var(--muted); }
  .band-head a:hover { color: var(--ink); }
  .reg-row { grid-template-columns: 180px 1fr auto; }
  @media (max-width: 640px) {
    .reg-row { grid-template-columns: 1fr; }
    .hero { min-height: 520px; }
  }
</style>
