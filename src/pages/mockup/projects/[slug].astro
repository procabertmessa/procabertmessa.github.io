---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Mockup from '../../../layouts/Mockup.astro';
import { getProjects } from '../../../lib/projects';
import { disciplineLabel } from '../../../data/categories';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, i, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, i, next } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = project.data;
const host = d.url?.replace(/^https?:\/\//, '').replace(/\/$/, '');
// The facts read like a small spec sheet: key on the left, value on the right.
const facts = [
  ['type', d.disciplines.map(disciplineLabel).join(', ')],
  ['with', d.context],
  ['role', d.role],
  ['location', d.location],
  ...d.facts.map((f) => [f.label.toLowerCase(), f.value]),
].filter(([, v]) => v) as [string, string][];
const images = d.chapters.length ? [] : d.images;
---

<Mockup title={d.title} active="projects">
  <article>
    <header class="wrap head">
      <p class="mono muted crumb"><a href={`${base}/mockup/#index`}>Index</a> / {String(i + 1).padStart(2, '0')}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
    </header>

    {d.cover && (
      <figure class="wrap cover">
        <Image src={d.cover} alt={d.title} widths={[800, 1400, 2200]} sizes="(max-width: 1120px) 100vw, 1056px" loading="eager" />
      </figure>
    )}

    <div class="wrap grid">
      <aside class="spec mono">
        <dl>
          {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
          {d.url && (<div><dt>live</dt><dd><a href={d.url} target="_blank" rel="noopener">{host} ↗</a></dd></div>)}
        </dl>
        {d.skills.length > 0 && (
          <>
            <p class="label muted">skills</p>
            <div class="chips">{d.skills.map((s) => <span class="chip">{s}</span>)}</div>
          </>
        )}
        {d.stack.length > 0 && (
          <>
            <p class="label muted">tools</p>
            <div class="chips">{d.stack.map((s) => <span class="chip">{s}</span>)}</div>
          </>
        )}
      </aside>

      <div class="body">
        <div class="prose"><Content /></div>

        {d.chapters.map((c, n) => (
          <section class="chapter">
            <p class="mono muted">{String(n + 1).padStart(2, '0')}</p>
            <h2>{c.title}</h2>
            <p>{c.text}</p>
            {c.images.map((img) => (
              <figure class:list={{ drawing: img.drawing }}>
                <Image src={img.src} alt={img.caption ?? c.title} widths={[700, 1400]} sizes="(max-width: 860px) 100vw, 720px" />
                {img.caption && <figcaption class="mono muted">{img.caption}</figcaption>}
              </figure>
            ))}
          </section>
        ))}

        {images.map((img) => (
          <figure class:list={{ drawing: img.drawing }}>
            <Image src={img.src} alt={img.caption ?? d.title} widths={[700, 1400]} sizes="(max-width: 860px) 100vw, 720px" />
            {img.caption && <figcaption class="mono muted">{img.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>

    <nav class="wrap next">
      <a href={`${base}/mockup/projects/${next.id}/`}>
        <span class="mono muted">Next project</span>
        <span class="nt">{next.data.title.split(' — ')[0]} →</span>
      </a>
    </nav>
  </article>
</Mockup>

<style>
  .head { padding-top: clamp(56px, 10vh, 112px); padding-bottom: 48px; }
  .crumb { margin: 0 0 24px; }
  .crumb a { text-decoration: none; }
  .crumb a:hover { color: var(--ink); }
  h1 { font-size: clamp(34px, 4.8vw, 60px); line-height: 1.04; letter-spacing: -0.04em; max-width: 18ch; }
  .lede { font-size: clamp(16px, 1.5vw, 19px); line-height: 1.55; max-width: 36em; margin: 24px 0 0; }
  .cover { margin: 0 auto 72px; }
  .cover :global(img) { width: 100%; max-height: 78vh; object-fit: cover; border-radius: 14px; }

  .grid { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 72px; align-items: start; }
  .spec { position: sticky; top: 84px; }
  .spec dl { margin: 0 0 28px; }
  .spec dl div { display: grid; grid-template-columns: 76px 1fr; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line); }
  .spec dt { color: var(--muted); }
  .spec dd { margin: 0; color: var(--ink); }
  .spec a { text-decoration: none; color: var(--green); }
  .label { margin: 0 0 10px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 24px; }
  .chips .chip { font-size: 11px; padding: 6px 9px; white-space: normal; line-height: 1.3; }

  .body { max-width: 680px; }
  .prose :global(h2), .chapter h2 { font-size: 22px; margin: 0 0 12px; }
  .prose :global(h2) { margin-top: 44px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(li), .chapter p { font-size: 16px; line-height: 1.7; }
  .prose :global(strong) { color: var(--ink); font-weight: 500; }
  .chapter { margin-top: 64px; }
  .chapter:first-of-type { margin-top: 0; }
  .chapter > p.mono { margin: 0 0 6px; }
  figure { margin: 36px 0 0; }
  figure :global(img) { width: 100%; border-radius: 10px; }
  figure.drawing :global(img) { background: #fff; padding: 12px; border: 1px solid var(--line); }
  figcaption { margin-top: 10px; }

  .next { margin-top: 120px; }
  .next a { display: flex; flex-direction: column; gap: 6px; padding: 32px 0; border-top: 1px solid var(--line); text-decoration: none; }
  .nt { font-size: clamp(22px, 3vw, 34px); color: var(--ink); letter-spacing: -0.03em; transition: transform .25s; }
  .next a:hover .nt { transform: translateX(6px); }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 40px; }
    .spec { position: static; }
    .cover { margin-bottom: 40px; }
    .cover :global(img) { border-radius: 10px; }
    .next { margin-top: 72px; }
  }
</style>
