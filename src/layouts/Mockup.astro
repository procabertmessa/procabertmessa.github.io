---
// Design mockup only: a very minimal, "AI tool" style take on the site, served under /mockup/.
// It shares the content collections and CV data with the live pages but none of their styles.
import { person } from '../data/cv';

interface Props {
  title?: string;
  active?: 'about' | 'projects' | 'home';
}
const { title, active = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = `${base}/mockup`;
const fullTitle = title ? `${title} · ${person.shortName}` : `${person.name} · ${person.headline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <a class="name" href={`${m}/`}>{person.name} <span><b>· </b>{person.headline}</span></a>
      <nav>
        <a href={`${m}/about/`} class:list={{ on: active === 'about' }}>About</a>
        <a href={`${m}/#index`} class:list={{ on: active === 'projects' }}>Projects</a>
        <a href={`mailto:${person.email}`}>Contact</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <span class="status"><i></i> Open to new roles · {person.location}</span>
      <span class="links">
        <a href={`mailto:${person.email}`}>{person.email}</a>
        <a href={person.linkedin} rel="noopener" target="_blank">LinkedIn ↗</a>
        <a href={`${base}${person.cv.en}`}>CV (PDF) ↓</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf8; --ink: #111; --body: #3d3d3a; --muted: #8a8a85; --line: #e6e6e1; --soft: #f0f0ec; --card: #fff;
    --green: #2f7d4f;
    --sans: 'Geist', system-ui, sans-serif; --mono: 'Geist Mono', ui-monospace, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0d0d0c; --ink: #f2f2ee; --body: #c4c4bd; --muted: #75756f; --line: #242422; --soft: #171716; --card: #141413; --green: #5fc488; color-scheme: dark; }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--body); font: 400 15px/1.6 var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  img { display: block; max-width: 100%; height: auto; }
  h1, h2, h3 { color: var(--ink); font-weight: 500; letter-spacing: -0.025em; margin: 0; }
  .mono { font-family: var(--mono); font-size: 12px; letter-spacing: 0; }
  .muted { color: var(--muted); }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 32px; }
  .narrow { max-width: 640px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; font: 400 12px/1 var(--mono); padding: 7px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--body); background: var(--card); text-decoration: none; white-space: nowrap; }
  @media (max-width: 640px) { .wrap { padding: 0 20px; } }
</style>

<style>
  .top { position: sticky; top: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 32px; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); font-size: 13px; }
  .name { text-decoration: none; color: var(--ink); font-weight: 500; }
  .name span { color: var(--muted); font-weight: 400; }
  .name b { font-weight: 400; }
  nav { display: flex; gap: 22px; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover, nav a.on { color: var(--ink); }
  main { min-height: 70vh; }
  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; padding: 28px 32px 36px; margin-top: 120px; border-top: 1px solid var(--line); font: 400 12px/1.5 var(--mono); color: var(--muted); }
  .foot a { text-decoration: none; }
  .foot a:hover { color: var(--ink); }
  .links { display: flex; gap: 20px; flex-wrap: wrap; }
  .status { display: inline-flex; align-items: center; gap: 8px; }
  .status i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 22%, transparent); }
  @media (max-width: 640px) {
    .top { padding: 14px 20px; align-items: flex-start; }
    .name { display: flex; flex-direction: column; line-height: 1.35; }
    .name span { font-size: 12px; }
    .name b { display: none; }
    nav { gap: 14px; padding-top: 1px; }
    .foot { padding: 24px 20px 32px; flex-direction: column; }
  }
</style>
