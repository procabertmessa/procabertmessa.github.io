---
// The drawing title block at the bottom of every sheet. It doubles as the site footer.
import { person } from '../data/cv';

interface Props {
  sheet: string;
  sheetTitle: string;
}
const { sheet, sheetTitle } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="tb mono">
  <span><span class="accent">{sheet}</span> · {sheetTitle}</span>
  <span class="muted">{person.name} · 41.39° N, 2.17° E · {person.location}</span>
  <span class="links">
    <a href={`mailto:${person.email}`}>Email</a>
    <a href={person.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
    <a href={`${base}${person.cv.en}`}>CV</a>
  </span>
</footer>

<style>
  .tb { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; padding: 40px 18px 32px; margin-top: 80px; border-top: 1px solid var(--line); color: var(--ink); }
  .links { display: flex; gap: 18px; }
  .links a { text-decoration: none; color: var(--muted); }
  .links a:hover { color: var(--ink); }
</style>
