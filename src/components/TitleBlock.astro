---
// The drawing title block at the bottom of every sheet. It doubles as the site footer.
import { person } from '../data/cv';

interface Props {
  sheet: string;
  sheetTitle: string;
}
const { sheet, sheetTitle } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="tb">
  <div class="cell sheet-no">
    <span class="lab">Sheet</span>
    <span class="big">{sheet}</span>
    <span class="t">{sheetTitle}</span>
  </div>
  <div class="cell">
    <span class="lab">Drawn by</span>
    {person.name}
  </div>
  <div class="cell">
    <span class="lab">Location</span>
    41.39° N, 2.17° E · {person.location}
  </div>
  <div class="cell">
    <span class="lab">Contact</span>
    <span class="links">
      <a href={`mailto:${person.email}`}>Email</a>
      <a href={person.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <a href={`${base}${person.cv.en}`}>CV</a>
    </span>
  </div>
  <div class="cell end">
    <span class="lab">Scale · Rev. {year}</span>
    <span class="scale" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
      <svg width="24" height="24" viewBox="0 0 26 26"><circle cx="13" cy="13" r="11" fill="none" stroke="currentColor" /><path d="M13 3 L17 19 L13 15 L9 19 Z" fill="currentColor" /></svg>
    </span>
  </div>
</footer>

<style>
  .tb { margin: 0 5px 5px; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1.1fr 1fr 1.1fr 1.1fr 0.9fr; font-size: 13px; color: var(--ink); position: relative; z-index: 3; background: var(--paper); }
  .cell { padding: 10px 14px; border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 3px; }
  .cell:first-child { border-left: 0; }
  .lab { font-family: var(--mono); font-size: 9.5px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .sheet-no { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 12px; align-items: end; }
  .sheet-no .lab { grid-column: 1 / -1; }
  .big { font-family: var(--mono); font-size: 22px; line-height: 1; color: var(--red); }
  .t { line-height: 1.2; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; }
  .scale { display: flex; align-items: center; }
  .scale i { display: block; width: 20px; height: 6px; border: 1px solid currentColor; }
  .scale i:nth-child(odd) { background: currentColor; }
  .scale svg { margin-left: 14px; }
  @media (max-width: 860px) {
    .tb { grid-template-columns: 1fr 1fr; }
    .cell:nth-child(n+3) { border-top: 1px solid var(--line); }
    .cell:nth-child(3) { border-left: 0; }
    .cell.end { grid-column: 1 / -1; border-left: 0; flex-direction: row; justify-content: space-between; align-items: center; }
  }
</style>
