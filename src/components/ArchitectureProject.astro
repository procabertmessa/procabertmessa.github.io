---
// Page body for projects without the data tag: a full-width cover image, the project text,
// then every image in a strip that scrolls sideways. Any image opens the full-screen viewer.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Lightbox from './Lightbox.astro';
import { disciplineLabel } from '../data/categories';

interface Props {
  project: CollectionEntry<'projects'>;
  no: string;
}
const { project, no } = Astro.props;
const d = project.data;
const gallery = [...(d.cover ? [{ src: d.cover, caption: d.title, drawing: false }] : []), ...d.images];
const offset = d.cover ? 1 : 0; // strip images start after the cover in the viewer
const facts = [
  ['Type', d.disciplines.map(disciplineLabel).join(' · ')],
  ['Site', d.location],
  ...d.facts.map((f) => [f.label, f.value]),
  ['Context', d.context],
  ['Role', d.role],
].filter(([, v]) => v) as [string, string][];
---

{d.cover && (
  <button type="button" class="hero" data-lightbox="0" aria-label="View images full screen">
    <Image src={d.cover} alt={d.title} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    <div class="hero-text">
      <p class="mono caps">{no}{d.location && ` · ${d.location.split(',')[0]}, ${d.location.split(',').at(-1)?.trim()}`}</p>
      <h1>{d.title}{d.draft && <span class="draft">Draft</span>}</h1>
      <span class="tags">{d.disciplines.map((t) => <span class="tag">{disciplineLabel(t)}</span>)}</span>
    </div>
  </button>
)}

<section class="intro">
  {!d.cover && <h1 class="plain">{d.title}{d.draft && <span class="draft">Draft</span>}</h1>}
  <p class="lead">{d.summary}</p>
  <dl class="facts">
    {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
  </dl>
</section>

<section class="text">
  <h2 class="mono caps label">The project</h2>
  <div class="cols prose"><slot /></div>
</section>

{d.images.length > 0 && (
  <section class="images">
    <div class="strip-head">
      <span class="mono caps muted">Images · {d.images.length}</span>
      <div class="arrows">
        <button type="button" data-strip="-1" aria-label="Previous images">←</button>
        <button type="button" data-strip="1" aria-label="Next images">→</button>
      </div>
    </div>
    <div class="strip" data-strip-track>
      {d.images.map((g, i) => (
        <figure>
          <button type="button" class:list={['shot', { drawing: g.drawing }]} data-lightbox={i + offset} aria-label={`View figure ${i + 1} full screen`}>
            <Image src={g.src} alt={g.caption ?? d.title} widths={[600, 1100]} sizes="(max-width: 760px) 90vw, 960px" />
          </button>
          <figcaption class="mono"><span class="accent">Fig. {String(i + 1).padStart(2, '0')}</span> {g.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

{gallery.length > 0 && <Lightbox title={d.title} images={gallery} />}

<script>
  const track = document.querySelector<HTMLElement>('[data-strip-track]');
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((b) =>
    b.addEventListener('click', () => track?.scrollBy({ left: Number(b.dataset.strip) * track.clientWidth * 0.6, behavior: 'smooth' })),
  );
</script>

<style>
  :global(body) { overflow-x: clip; }
  /* Full-bleed blocks break out of the centred sheet. */
  .hero, .strip { width: 100vw; margin-left: calc(50% - 50vw); }
  .hero { position: relative; display: block; padding: 0; border: 0; background: none; cursor: zoom-in; color: #f2f1ee; text-align: left; }
  .hero :global(img) { display: block; width: 100%; height: min(86vh, 900px); object-fit: cover; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.7)); }
  .hero-text { position: absolute; z-index: 1; left: 0; right: 0; bottom: 40px; max-width: var(--wrap); margin: 0 auto; padding: 0 42px; }
  .hero-text p { margin: 0; color: #d6d4cf; font-size: 11px; }
  .hero h1, .plain { font-size: clamp(44px, 7vw, 104px); font-weight: 400; letter-spacing: -0.045em; line-height: 0.95; margin: 10px 0 16px; }
  .tags { display: flex; gap: 6px; }
  .tag { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; border: 1px solid currentColor; padding: 3px 8px; color: #9fd8b6; }

  .intro { display: grid; grid-template-columns: 1.35fr 1fr; gap: 72px; padding: 80px 18px 64px; border-bottom: 1px solid var(--line); }
  .intro .plain { grid-column: 1 / -1; margin: 0; }
  .lead { font-size: 26px; line-height: 1.35; letter-spacing: -0.015em; margin: 0; color: var(--ink); }
  .facts { display: grid; grid-template-columns: 110px 1fr; row-gap: 12px; margin: 0; align-content: start; font-size: 14px; }
  .facts dt { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding-top: 3px; }
  .facts dd { margin: 0; color: var(--body); }

  .text { display: grid; grid-template-columns: 220px 1fr; gap: 40px; padding: 64px 18px 72px; }
  .label { margin: 0; font-size: 11px; font-weight: 400; color: var(--accent); }
  .cols { columns: 2; column-gap: 48px; max-width: 880px; }
  .cols :global(h2) { font-family: var(--sans); font-size: 17px; font-weight: 400; text-transform: none; letter-spacing: 0; margin: 0 0 8px; break-after: avoid; }
  .cols :global(p) { margin: 0 0 28px; break-inside: avoid; }

  .strip-head { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--line); padding: 20px 18px 18px; }
  .arrows { display: flex; gap: 8px; }
  .arrows button { font: inherit; font-size: 16px; background: none; color: var(--ink); border: 1px solid var(--line); width: 44px; height: 44px; cursor: pointer; }
  .arrows button:hover { background: var(--ink); color: var(--paper); }
  .strip {
    --edge: max(42px, calc((100vw - var(--wrap)) / 2 + 42px));
    display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: var(--edge);
    padding: 0 var(--edge) 20px; scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  .strip figure { flex: none; margin: 0; scroll-snap-align: start; }
  .shot { display: block; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .shot.drawing { background: #fff; padding: 10px; }
  .shot :global(img) { display: block; height: min(560px, 62vh); width: auto; }
  .shot.drawing :global(img) { height: calc(min(560px, 62vh) - 20px); }
  figcaption { margin-top: 8px; font-size: 11px; color: var(--muted); }

  @media (max-width: 760px) {
    .hero :global(img) { height: 76vh; }
    .hero-text { padding: 0 22px; bottom: 28px; }
    .intro { grid-template-columns: 1fr; gap: 32px; padding: 44px 14px; }
    .lead { font-size: 20px; }
    .text { grid-template-columns: 1fr; gap: 16px; padding: 40px 14px 48px; }
    .cols { columns: 1; }
    .arrows { display: none; }
    .strip { --edge: 22px; }
    .shot :global(img) { height: 300px; }
    .shot.drawing :global(img) { height: 280px; }
  }
</style>
