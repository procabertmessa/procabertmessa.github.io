---
// Page body for projects without the data tag: title, then the cover beside the summary and facts,
// then the story in short chapters, each with its own drawings and images. Any image opens the full-screen viewer.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Lightbox from './Lightbox.astro';
import { disciplineLabel } from '../data/categories';

interface Props {
  project: CollectionEntry<'projects'>;
  no: string;
}
const { project, no } = Astro.props;
const d = project.data;
const cover = d.cover ? [{ src: d.cover, caption: d.title, drawing: false }] : [];
// Number every chapter image in reading order; the cover is Fig. 00 in the viewer.
let n = cover.length;
const chapters = d.chapters.map((c) => ({ ...c, images: c.images.map((img) => ({ ...img, i: n++ })) }));
const gallery = [...cover, ...d.chapters.flatMap((c) => c.images)];
const facts = [
  ['Type', d.disciplines.map(disciplineLabel).join(' · ')],
  ['Site', d.location],
  ...d.facts.map((f) => [f.label, f.value]),
  ['Context', d.context],
  ['Role', d.role],
].filter(([, v]) => v) as [string, string][];
const region = d.location?.split(',').slice(-2, -1)[0]?.trim() ?? d.location;
---

<section class="title">
  <p class="mono caps muted">{no}{region && ` · ${region}`}</p>
  <h1>{d.title}{d.draft && <span class="draft">Draft</span>}</h1>
  <span class="tags">{d.disciplines.map((t) => <span class="tag">{disciplineLabel(t)}</span>)}</span>
</section>

<section class="intro">
  {d.cover && (
    <figure class="cover">
      <button type="button" data-lightbox="0" aria-label="View images full screen">
        <Image src={d.cover} alt={d.title} widths={[700, 1100, 1400]} sizes="(max-width: 860px) 100vw, 640px" loading="eager" />
      </button>
    </figure>
  )}
  <div>
    <p class="lead">{d.summary}</p>
    <dl class="facts">
      {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    </dl>
  </div>
</section>

{chapters.map((c, ci) => (
  <section class="chapter">
    <div class="side">
      <p class="no mono">{String(ci + 1).padStart(2, '0')}</p>
      <h2>{c.title}</h2>
      <p class="text">{c.text}</p>
      {c.scales.length > 0 && <div class="chips">{c.scales.map((s) => <span>{s}</span>)}</div>}
    </div>
    <div class="figs" style={`--cols: ${Math.min(c.images.length, 3)}`}>
      {c.images.map((img) => (
        <figure>
          <button type="button" class:list={['frame', { drawing: img.drawing }]} data-lightbox={img.i} aria-label={`View figure ${img.i} full screen`}>
            <Image src={img.src} alt={img.caption ?? d.title} widths={[500, 900]} sizes="(max-width: 860px) 100vw, 420px" />
          </button>
          <figcaption class="mono"><span class="accent">Fig. {String(img.i).padStart(2, '0')}</span> {img.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
))}

{gallery.length > 0 && <Lightbox title={d.title} images={gallery} />}

<style>
  .title { padding: 56px 18px 32px; }
  .title p { margin: 0; font-size: 11px; }
  h1 { font-size: clamp(40px, 5.6vw, 80px); font-weight: 400; letter-spacing: -0.045em; line-height: 1; margin: 10px 0 14px; }
  .tags { display: flex; gap: 6px; }
  .tag { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; border: 1px solid currentColor; padding: 3px 8px; color: var(--accent); }

  .intro { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; padding: 0 18px 56px; border-bottom: 1px solid var(--line); }
  .cover { margin: 0; }
  .cover button { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .cover :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  .lead { font-size: 21px; line-height: 1.4; letter-spacing: -0.01em; margin: 0 0 28px; color: var(--ink); }
  .facts { display: grid; grid-template-columns: 100px 1fr; row-gap: 10px; margin: 0; font-size: 13.5px; }
  .facts dt { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding-top: 3px; }
  .facts dd { margin: 0; color: var(--body); }

  .chapter { display: grid; grid-template-columns: 300px 1fr; gap: 56px; padding: 56px 18px; border-bottom: 1px solid var(--line); }
  .side { position: sticky; top: 24px; align-self: start; }
  .no { margin: 0; color: var(--accent); }
  .chapter h2 { font-size: 26px; font-weight: 400; letter-spacing: -0.02em; margin: 8px 0 14px; }
  .text { font-size: 14.5px; line-height: 1.6; color: var(--body); margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .chips span { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); border: 1px solid var(--line); padding: 3px 8px; }

  .figs { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 16px; align-items: start; }
  .figs figure { margin: 0; }
  .frame { display: grid; place-items: center; width: 100%; aspect-ratio: 4 / 3; padding: 0; border: 0; overflow: hidden; background: #151517; cursor: zoom-in; }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .frame.drawing { background: #fff; padding: 4px; }
  .frame.drawing :global(img) { object-fit: contain; }
  .frame:hover { outline: 1px solid var(--accent); }
  figcaption { margin-top: 7px; font-size: 10.5px; color: var(--muted); }

  @media (max-width: 860px) {
    .title { padding: 32px 14px 24px; }
    .intro { grid-template-columns: 1fr; gap: 28px; padding: 0 14px 40px; }
    .lead { font-size: 18px; }
    .chapter { grid-template-columns: 1fr; gap: 24px; padding: 40px 14px; }
    .side { position: static; }
    .figs { grid-template-columns: 1fr; }
    .frame { aspect-ratio: 4 / 3; }
  }
</style>
