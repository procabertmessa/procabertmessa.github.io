---
// Animated parcel map drawn on a canvas: the Eixample where Passeig de Sant Joan meets Avinguda Diagonal. Cerdà proportions (113 m blocks, 20 m streets, 15 m chamfers, 50 m avenues); the
// Diagonal cuts the blocks it crosses. Each block is lined with plots around an open courtyard, and a slow
// wave lights up some plots, like an analysis running across the city. The plots are generated, not real data.
---

<canvas class="parcel-map" aria-hidden="true"></canvas>

<script>
  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    type P = { x: number; y: number; w: number; h: number; v: number };
    type B = { x: number; y: number; plots: P[] };
    let blocks: B[] = [];
    let W = 0, H = 0, X0 = 0, Y0 = 0;
    let colors = { line: '', fill: '', label: '', greens: [] as string[] };
    let seed = 11;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const PITCH = 150, SIDE = (PITCH * 113.3) / 133.3, CHAMFER = (PITCH * 15) / 133.3, ANGLE = -0.12;
    const DEPTH = SIDE * 0.26;
    const M = PITCH / 133.3; // pixels per metre
    const AVENUE = 50 * M, STREET = 20 * M;
    const DIAG = Math.atan(0.5); // the Diagonal runs down towards Glòries

    // Cuts a strip into plots of uneven frontage.
    function strip(x: number, y: number, w: number, h: number, along: 'x' | 'y', out: P[]) {
      const len = along === 'x' ? w : h;
      let t = 0;
      while (t < len - 1) {
        const step = Math.min(len - t, len * (0.1 + rnd() * 0.12));
        out.push(along === 'x' ? { x: x + t, y, w: step, h, v: rnd() } : { x, y: y + t, w, h: step, v: rnd() });
        t += step;
      }
    }

    function plotsFor(): P[] {
      const out: P[] = [];
      strip(0, 0, SIDE, DEPTH, 'x', out);
      strip(0, SIDE - DEPTH, SIDE, DEPTH, 'x', out);
      strip(0, DEPTH, DEPTH, SIDE - 2 * DEPTH, 'y', out);
      strip(SIDE - DEPTH, DEPTH, DEPTH, SIDE - 2 * DEPTH, 'y', out);
      // Some courtyards still hold a building, as many in the Eixample do.
      if (rnd() > 0.6) out.push({ x: DEPTH + 6, y: DEPTH + 6, w: SIDE - 2 * DEPTH - 12, h: (SIDE - 2 * DEPTH) * (0.3 + rnd() * 0.4), v: rnd() });
      return out;
    }

    function octagon(x: number, y: number) {
      const s = SIDE, c = CHAMFER;
      ctx.beginPath();
      ctx.moveTo(x + c, y); ctx.lineTo(x + s - c, y); ctx.lineTo(x + s, y + c); ctx.lineTo(x + s, y + s - c);
      ctx.lineTo(x + s - c, y + s); ctx.lineTo(x + c, y + s); ctx.lineTo(x, y + s - c); ctx.lineTo(x, y + c);
      ctx.closePath();
    }

    function readColors() {
      const s = getComputedStyle(document.documentElement);
      const dark = document.documentElement.dataset.theme !== 'light';
      colors = {
        line: dark ? 'rgba(236,232,223,0.2)' : 'rgba(22,22,22,0.32)',
        fill: dark ? 'rgba(236,232,223,0.06)' : 'rgba(22,22,22,0.07)',
        // Three emerald tones, so lit plots read as a field of greens rather than one flat colour.
        greens: dark ? ['#1f7a55', '#2e9b6c', '#5cc596'] : ['#17603a', '#23855a', '#3fa67a'],
      };
    }

    function build() {
      const dpr = window.devicePixelRatio || 1;
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      blocks = []; seed = 11;
      // The crossing sits right of centre, clear of the headline.
      X0 = W * (W < 700 ? 0.62 : 0.7); Y0 = H * 0.4;
      const cols = Math.ceil(W / PITCH) + 3, rows = Math.ceil(H / PITCH) + 3;
      for (let i = -cols; i < cols; i++) {
        // Passeig de Sant Joan is the wide street between column -1 and column 0.
        const x = i >= 0 ? X0 + AVENUE / 2 + i * PITCH : X0 - AVENUE / 2 - SIDE + (i + 1) * PITCH;
        for (let j = -rows; j < rows; j++) blocks.push({ x, y: Y0 + STREET / 2 + j * PITCH, plots: plotsFor() });
      }
      readColors();
    }

    // Everything outside a shape: a huge rectangle with the shape cut out (even-odd).
    function outside(shape: () => void) {
      ctx.beginPath();
      ctx.rect(-W * 4, -H * 4, W * 9, H * 9);
      shape();
      ctx.clip('evenodd');
    }
    const L = 6000;
    const dx = Math.cos(DIAG), dy = Math.sin(DIAG), nx = -dy, ny = dx;
    function diagonal() {
      const h = AVENUE / 2;
      ctx.moveTo(X0 - dx * L + nx * h, Y0 - dy * L + ny * h);
      ctx.lineTo(X0 + dx * L + nx * h, Y0 + dy * L + ny * h);
      ctx.lineTo(X0 + dx * L - nx * h, Y0 + dy * L - ny * h);
      ctx.lineTo(X0 - dx * L - nx * h, Y0 - dy * L - ny * h);
      ctx.closePath();
    }

    function labels() {
      ctx.fillStyle = colors.label;
      ctx.font = '11px "IBM Plex Mono", monospace';
      ctx.save();
      ctx.translate(X0 + 4, Y0 + PITCH * 1.8); ctx.rotate(-Math.PI / 2);
      ctx.fillText('PG. DE SANT JOAN', 0, 0);
      ctx.restore();
      ctx.save();
      ctx.translate(X0 + dx * PITCH * 1.2, Y0 + dy * PITCH * 1.2 + 3); ctx.rotate(DIAG);
      ctx.fillText('AV. DIAGONAL', 0, 0);
      ctx.restore();
    }

    function draw(time: number) {
      ctx.clearRect(0, 0, W, H);
      ctx.save();
      ctx.translate(W * 0.55, H * 0.5); ctx.rotate(ANGLE); ctx.translate(-W * 0.55, -H * 0.5);
      const wave = reduced ? 0.7 : ((time / 4500) % 1.6) - 0.3;
      ctx.lineWidth = 0.5;
      ctx.strokeStyle = colors.line;
      ctx.save();
      // The Diagonal is carved out of the grid.
      outside(diagonal);
      for (const b of blocks) {
        ctx.save();
        octagon(b.x, b.y);
        ctx.clip();
        for (const p of b.plots) {
          const x = b.x + p.x, y = b.y + p.y;
          const d = Math.abs(x / W - wave);
          const lit = p.v > 0.86 && d < 0.18;
          ctx.beginPath();
          ctx.rect(x, y, p.w, p.h);
          if (lit) {
            ctx.globalAlpha = Math.max(0, 0.9 - d * 4);
            ctx.fillStyle = colors.greens[Math.floor(((p.v - 0.86) / 0.14) * 3) % 3]; ctx.fill();
            ctx.globalAlpha = 1;
          } else if (p.v > 0.95) {
            ctx.fillStyle = colors.fill; ctx.fill();
          }
          ctx.stroke();
        }
        ctx.restore();
        octagon(b.x, b.y);
        ctx.lineWidth = 0.9; ctx.stroke(); ctx.lineWidth = 0.5;
      }
      ctx.restore();
      // Edges of the Diagonal, drawn only where they cut a block.
      ctx.save();
      ctx.beginPath();
      for (const b of blocks) {
        const s = SIDE, c = CHAMFER, x = b.x, y = b.y;
        ctx.moveTo(x + c, y); ctx.lineTo(x + s - c, y); ctx.lineTo(x + s, y + c); ctx.lineTo(x + s, y + s - c);
        ctx.lineTo(x + s - c, y + s); ctx.lineTo(x + c, y + s); ctx.lineTo(x, y + s - c); ctx.lineTo(x, y + c); ctx.closePath();
      }
      ctx.clip();
      ctx.beginPath(); diagonal(); ctx.lineWidth = 0.9; ctx.stroke();
      ctx.restore();
      labels();
      ctx.restore();
      if (!reduced) requestAnimationFrame(draw);
    }

    build();
    requestAnimationFrame(draw);
    new ResizeObserver(build).observe(canvas);
    window.addEventListener('themechange', readColors);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.parcel-map').forEach(start);
</script>

<style>
  .parcel-map { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>
