---
// Animated parcel map drawn on a canvas: a slightly rotated Cerdà-style grid of blocks,
// each subdivided into parcels. A slow wave passes over it and lights up some parcels,
// like an analysis running across the city. The parcels are generated, not real data.
---

<canvas class="parcel-map" aria-hidden="true"></canvas>

<script>
  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    type P = { x: number; y: number; w: number; h: number; v: number };
    let parcels: P[] = [];
    let W = 0, H = 0;
    let colors = { line: '', fill: '', hot: '' };
    let seed = 11;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const BLOCK = 120, STREET = 12, ANGLE = -0.12;

    function split(x: number, y: number, w: number, h: number, d: number, out: P[]) {
      if (d === 0 || w < 26 || h < 26) { out.push({ x, y, w, h, v: rnd() }); return; }
      const r = 0.3 + rnd() * 0.4;
      if (w > h) { split(x, y, w * r, h, d - 1, out); split(x + w * r, y, w * (1 - r), h, d - 1, out); }
      else { split(x, y, w, h * r, d - 1, out); split(x, y + h * r, w, h * (1 - r), d - 1, out); }
    }

    function readColors() {
      const s = getComputedStyle(document.documentElement);
      const ink = s.getPropertyValue('--line').trim();
      const dark = (document.documentElement.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
      colors = {
        line: dark ? 'rgba(236,232,223,0.22)' : 'rgba(22,22,22,0.32)',
        fill: dark ? 'rgba(236,232,223,0.06)' : 'rgba(22,22,22,0.07)',
        hot: s.getPropertyValue('--red').trim() || ink,
      };
    }

    function build() {
      const dpr = window.devicePixelRatio || 1;
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      parcels = []; seed = 11;
      for (let gx = -3; gx < W / BLOCK + 3; gx++) {
        for (let gy = -3; gy < H / BLOCK + 3; gy++) {
          const out: P[] = [];
          split(0, 0, BLOCK - STREET, BLOCK - STREET, 3, out);
          out.forEach((p) => parcels.push({ ...p, x: p.x + gx * BLOCK, y: p.y + gy * BLOCK }));
        }
      }
      readColors();
    }

    function draw(time: number) {
      ctx.clearRect(0, 0, W, H);
      ctx.save();
      ctx.translate(W * 0.55, H * 0.5); ctx.rotate(ANGLE); ctx.translate(-W * 0.55, -H * 0.5);
      const wave = reduced ? 0.7 : ((time / 4500) % 1.6) - 0.3;
      ctx.lineWidth = 0.5;
      ctx.strokeStyle = colors.line;
      for (const p of parcels) {
        const d = Math.abs(p.x / W - wave);
        const lit = p.v > 0.86 && d < 0.18;
        ctx.beginPath();
        ctx.rect(p.x + 1, p.y + 1, p.w - 2, p.h - 2);
        if (lit) {
          ctx.globalAlpha = Math.max(0, 0.9 - d * 4);
          ctx.fillStyle = colors.hot; ctx.fill();
          ctx.globalAlpha = 1;
        } else if (p.v > 0.95) {
          ctx.fillStyle = colors.fill; ctx.fill();
        }
        ctx.stroke();
      }
      ctx.restore();
      if (!reduced) requestAnimationFrame(draw);
    }

    build();
    requestAnimationFrame(draw);
    new ResizeObserver(build).observe(canvas);
    window.addEventListener('themechange', readColors);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readColors);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.parcel-map').forEach(start);
</script>

<style>
  .parcel-map { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>
