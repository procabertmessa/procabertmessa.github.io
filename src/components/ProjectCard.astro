---
interface Props {
  slug: string;
  title: string;
  summary: string;
  context: string;
  year?: string;
  tags: string[];
  index?: number;
}
const { slug, title, summary, context, year, tags, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="card">
  <a href={`${base}/projects/${slug}/`}>
    {index !== undefined && <span class="num">{String(index + 1).padStart(2, '0')}</span>}
    <p class="ctx">{context}{year && ` · ${year}`}</p>
    <h3>{title}</h3>
    <p class="sum">{summary}</p>
    <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
    <span class="more">Read case study →</span>
  </a>
</article>

<style>
  .card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); transition: transform 0.2s, border-color 0.2s; }
  .card:hover { transform: translateY(-3px); border-color: var(--accent); }
  a { display: flex; flex-direction: column; height: 100%; padding: 28px; color: inherit; text-decoration: none; }
  .num { font-family: var(--serif); font-size: 0.95rem; color: var(--warm); margin-bottom: 14px; }
  .ctx { font-size: 0.8rem; color: var(--muted); margin-bottom: 8px; }
  h3 { margin-bottom: 12px; }
  .sum { font-size: 0.95rem; flex: 1; }
  .tags { margin-bottom: 18px; }
  .more { font-size: 0.9rem; font-weight: 500; color: var(--accent); }
</style>
