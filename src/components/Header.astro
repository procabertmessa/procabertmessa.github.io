---
import { person } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
];
const path = Astro.url.pathname.replace(base, '') || '/';
---

<header class="container bar">
  <a class="brand" href={`${base}/`}>{person.shortName}</a>
  <nav aria-label="Main">
    {links.map((l) => (
      <a href={`${base}${l.href}`} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <button class="theme" type="button" aria-label="Toggle dark mode"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg></button>
  </nav>
</header>

<script>
  document.querySelector('.theme')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>

<style>
  .bar { display: flex; align-items: center; justify-content: space-between; height: 80px; gap: 16px; }
  .brand { color: var(--ink); text-decoration: none; font-weight: 500; letter-spacing: -0.01em; }
  nav { display: flex; align-items: center; gap: 24px; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  .theme { background: none; border: 0; color: var(--muted); cursor: pointer; padding: 4px; display: grid; place-items: center; }
  .theme:hover { color: var(--ink); }
  @media (max-width: 480px) { nav { gap: 16px; } }
</style>
