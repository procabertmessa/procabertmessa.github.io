---
import { person } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: '/projects/', label: 'Projects', code: 'P-00' },
  { href: '/about/', label: 'About', code: 'A-01' },
  { href: '/blog/', label: 'Blog', code: 'B-00' },
];
const path = Astro.url.pathname.replace(base, '') || '/';
---

<header class="bar">
  <a class="brand" href={`${base}/`}>
    <span class="name">{person.name}</span>
    <span class="tag mono muted">Architect &amp; Urban Design Manager</span>
  </a>
  <nav aria-label="Main">
    {links.map((l) => (
      <a href={`${base}${l.href}`} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
    <button class="theme" type="button" aria-label="Switch between dark and light">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>
    </button>
  </nav>
</header>

<script>
  document.querySelector('.theme')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme !== 'light';
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    window.dispatchEvent(new Event('themechange'));
  });
</script>

<style>
  .bar { display: flex; justify-content: space-between; align-items: center; padding: 22px 18px; position: relative; z-index: 3; }
  .brand { display: flex; align-items: baseline; gap: 14px; text-decoration: none; color: var(--ink); }
  .brand:hover { color: var(--ink); }
  .name { font-weight: 500; letter-spacing: -0.01em; font-size: 15px; }
  nav { display: flex; align-items: center; gap: 28px; }
  nav a { text-decoration: none; font-size: 14px; color: var(--muted); }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  .theme { border: 0; background: none; color: var(--muted); padding: 0; cursor: pointer; display: grid; place-items: center; }
  .theme:hover { color: var(--ink); }
  @media (max-width: 760px) {
    .tag { display: none; }
  }
  @media (max-width: 520px) {
    nav { gap: 16px; }
    nav a { font-size: 13px; }
  }
</style>
