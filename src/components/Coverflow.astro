---
// Sideways gallery: the image in the middle is shown large, its neighbours sit behind it,
// smaller and dimmed. Swipe, scroll, use the arrows or the keyboard; click the middle one to enlarge.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  images: { src: ImageMetadata; caption?: string }[];
  placeholders?: number;
}
const { title, images, placeholders = 0 } = Astro.props;
const total = images.length || placeholders;
---

<div class="coverflow" data-coverflow>
  <div class="stage">
    <ul class="track" tabindex="0" aria-label={`${title}: images`}>
      {images.map((img, i) => (
        <li class="item" data-caption={img.caption ?? ''}>
          <button type="button" class="frame" aria-label={`Enlarge figure ${i + 1}`}>
            <Image src={img.src} alt={img.caption ?? title} widths={[600, 1000, 1600]} sizes="(max-width: 860px) 80vw, 560px" loading={i < 3 ? 'eager' : 'lazy'} />
          </button>
        </li>
      ))}
      {images.length === 0 && Array.from({ length: placeholders }, (_, i) => (
        <li class="item" data-caption="Image to come">
          <div class="frame empty"><span class="mono caps">Fig. {String(i + 1).padStart(2, '0')}</span></div>
        </li>
      ))}
    </ul>
  </div>
  <div class="controls mono">
    <span class="count"><span class="red" data-index>Fig. 01</span> / {String(total).padStart(2, '0')}</span>
    <span class="caption" data-caption-out></span>
    <span class="arrows">
      <button type="button" data-prev aria-label="Previous image">←</button>
      <button type="button" data-next aria-label="Next image">→</button>
    </span>
  </div>
  <dialog class="zoom">
    <form method="dialog"><button class="close mono" aria-label="Close">Close ✕</button></form>
    <img alt="" />
  </dialog>
</div>

<script>
  function setup(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('.track')!;
    const items = [...track.querySelectorAll<HTMLElement>('.item')];
    const indexOut = root.querySelector<HTMLElement>('[data-index]')!;
    const captionOut = root.querySelector<HTMLElement>('[data-caption-out]')!;
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    let current = 0;

    function layout() {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0, bestD = Infinity;
      items.forEach((el, i) => {
        const c = el.offsetLeft + el.offsetWidth / 2;
        const o = (c - mid) / el.offsetWidth; // -1 = one slot left, +1 = one slot right
        const a = Math.min(Math.abs(o), 3);
        // The current image fills the slot; neighbours drop to small thumbnails that sit
        // just beside it, and anything further out fades away behind them.
        const near = Math.min(a, 1), far = Math.max(a - 1, 0);
        const scale = 1 - near * 0.72 - far * 0.04;
        const target = Math.sign(o) * (near * 0.58 + far * 0.26) * el.offsetWidth;
        const shift = target - o * el.offsetWidth;
        el.style.transform = `translateX(${shift}px) perspective(1200px) rotateY(${-Math.sign(o) * near * 18}deg) scale(${scale})`;
        el.style.opacity = String(Math.max(0, 1 - near * 0.45 - far * 0.3));
        el.style.zIndex = String(100 - Math.round(a * 10));
        el.classList.toggle('is-current', a < 0.5);
        if (Math.abs(o) < bestD) { bestD = Math.abs(o); best = i; }
      });
      if (best !== current || !indexOut.dataset.ready) {
        current = best;
        indexOut.dataset.ready = '1';
        indexOut.textContent = `Fig. ${String(best + 1).padStart(2, '0')}`;
        captionOut.textContent = items[best].dataset.caption ?? '';
      }
    }

    function go(i: number) {
      const el = items[Math.max(0, Math.min(items.length - 1, i))];
      track.scrollTo({ left: el.offsetLeft + el.offsetWidth / 2 - track.clientWidth / 2, behavior: 'smooth' });
    }

    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(layout); }, { passive: true });
    new ResizeObserver(layout).observe(track);
    root.querySelector('[data-prev]')!.addEventListener('click', () => go(current - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(current + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1); }
    });
    items.forEach((el, i) => {
      el.querySelector('button.frame')?.addEventListener('click', () => {
        if (i !== current) return go(i);
        const img = el.querySelector('img')!;
        const zoom = dialog.querySelector('img')!;
        zoom.src = img.currentSrc || img.src;
        zoom.alt = img.alt;
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    layout();
  }
  document.querySelectorAll<HTMLElement>('[data-coverflow]').forEach(setup);
</script>

<style>
  .coverflow { display: flex; flex-direction: column; height: 100%; }
  .stage { flex: 1; min-height: 0; display: flex; overflow: hidden; padding: 24px 0; }
  .track {
    list-style: none; margin: 0; padding: 0 9%;
    display: flex; width: 100%; height: 100%;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    outline-offset: -2px;
  }
  .track::-webkit-scrollbar { display: none; }
  .item { flex: 0 0 100%; height: 100%; scroll-snap-align: center; transform-origin: center; will-change: transform; position: relative; }
  /* The frame fills the slot; the drawing keeps its own proportions inside it. */
  .frame {
    display: flex; align-items: center; justify-content: center;
    width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer;
  }
  .frame :global(img) { width: auto; height: auto; max-width: 100%; max-height: 100%; background: #f4f2ec; border: 1px solid var(--line); }
  .item:not(.is-current) .frame { cursor: pointer; }
  .item.is-current .frame { cursor: zoom-in; }
  .item.is-current .frame :global(img) { box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4); }
  .empty {
    display: grid; place-items: center; cursor: default; height: auto; aspect-ratio: 4 / 3; margin: auto 0;
    border: 1px dashed var(--muted); color: var(--muted);
    background-image: repeating-linear-gradient(-45deg, transparent 0 14px, var(--faint) 14px 15px);
  }

  .controls {
    display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center;
    padding: 10px 18px; border-top: 1px solid var(--line); color: var(--ink);
  }
  .caption { color: var(--body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .arrows { display: flex; }
  .arrows button {
    font: inherit; font-size: 14px; color: var(--ink); background: none; cursor: pointer;
    border: 1px solid var(--line); width: 36px; height: 30px;
  }
  .arrows button + button { border-left: 0; }
  .arrows button:hover { background: var(--hover-bg); color: var(--hover-fg); }

  .zoom { max-width: 96vw; max-height: 96vh; padding: 0; border: 1px solid var(--line); background: var(--paper); }
  .zoom::backdrop { background: rgba(0, 0, 0, 0.82); }
  .zoom img { max-width: 94vw; max-height: 88vh; object-fit: contain; background: #f4f2ec; }
  .zoom form { display: flex; justify-content: flex-end; }
  .close { background: none; border: 0; color: var(--ink); padding: 8px 12px; cursor: pointer; }

  @media (prefers-reduced-motion: reduce) {
    .item { transition: none; }
  }
</style>
